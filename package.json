{
  "name": "hydrobuddy",
  "version": "1.8.1",
  "private": true,
  "description": "Your little desktop hydration companion",
  "author": "HydroBuddy",
  "main": "out/main/main.js",
  "scripts": {
    "dev": "electron-vite dev",
    "dev:fast": "electron-vite dev -- --fast-reminders",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "vitest run",
    "test:desktop": "npm run build && node scripts/desktop-test.cjs",
    "build": "npm run typecheck && electron-vite build",
    "package": "npm run build && electron-builder --win nsis --x64",
    "package:dir": "npm run build && electron-builder --dir",
    "dev:personal": "electron-vite dev -- --demo-avatar"
  },
  "dependencies": {
    "image-size": "^2.0.4",
    "lucide-react": "^0.468.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.0",
    "@types/node": "^22.19.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^5.0.0",
    "electron": "^44.7.0",
    "electron-builder": "^26.0.0",
    "electron-vite": "^5.0.0",
    "eslint": "^9.39.0",
    "playwright": "^1.56.0",
    "sharp": "^0.35.5",
    "typescript": "^5.9.0",
    "typescript-eslint": "^8.46.0",
    "vite": "^7.1.0",
    "vitest": "^5.0.3"
  },
  "build": {
    "appId": "com.hydrobuddy.desktop",
    "productName": "HydroBuddy",
    "directories": {
      "output": "release",
      "buildResources": "resources"
    },
    "files": [
      "out/**/*",
      "resources/icon.png",
      "resources/icon.ico",
      "package.json"
    ],
    "asar": true,
    "win": {
      "target": "nsis",
      "icon": "resources/icon.ico",
      "signExecutable": false
    },
    "nsis": {
      "artifactName": "HydroBuddy-Setup.${ext}",
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "deleteAppDataOnUninstall": false
    },
    "mac": {
      "category": "public.app-category.healthcare-fitness",
      "target": "dmg",
      "icon": "resources/icon.png"
    }
  }
}
